# ===========================================================================
# Local data / generated test artifacts
# ===========================================================================

# A drawing is not versioned by default.
*.dxf
*.dwg

# tests/examples/ is local only: client originals, job folders, scratch
# output. Nothing in here ever enters git, and no rule below re-includes it.
tests/examples/

# Generated artifacts outside tests/data/
tests/examples/**/golden/
tests/examples/**/generated/
tests/examples/**/output/
tests/examples/**/outputs/
**/*golden*.json
pipeline_output/

# tests/data/ is the tracked root the suite reads: the drawings that passed
# `scripts/audit_names.py` and `anonymize scan`, plus their goldens and
# configs. It comes last, so it wins over every rule above — which is the
# point: a drawing is publishable because of the folder it is in, not
# because someone remembered a `git add -f`.
!tests/data/
!tests/data/**
mixed_pipeline_output/
output/

# ===========================================================================
# Notebooks
# ===========================================================================

*.ipynb
.ipynb_checkpoints/

# ===========================================================================
# Local work-in-progress scripts (kept on disk, not part of the repo)
# ===========================================================================

/scripts/13_ARC_splitter_injected_fuzzy_new.py

# ===========================================================================
# Local private notes (never on GitHub)
# ===========================================================================

chiacchierata_con_ai.*

# ===========================================================================
# Local configuration / secrets
# ===========================================================================

.env
.env.*
!.env.example

# ===========================================================================
# Temporary / backup files
# ===========================================================================

*.log
*.tmp
*.bak
*.orig
*~
# Private design notes
HEALSTEP_REFACTOR.md
# Prototipi e archivio: solo locali
dev_tools/
_archive/

# PNG di debug in tests/lab (output matplotlib, fase chiusa)
tests/lab/*.png
